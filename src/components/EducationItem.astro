---
export interface Props {
    title: string;
    institution: string;
    date: string;
}

const { title, institution, date } = Astro.props;
---

<div>
    <h3 class="text-sm leading-snug font-medium text-cream-100">
        {title}
    </h3>
    <p class="text-[13px] leading-relaxed text-cream-300">{institution}</p>
    <p
        class="font-mono text-[11px] tracking-[0.04em] text-cream-500 tabular-nums"
    >
        {date}
    </p>
</div>
