---
export interface Props {
    title: string;
    institution: string;
    date: string;
}

const { title, institution, date } = Astro.props;
---

<div>
    <h4 class="font-medium">{title}</h4>
    <div class="flex flex-col justify-between text-sm italic">
        <p class="italic">{institution}</p>
        <p>{date}</p>
    </div>
</div>
