---
export interface Props {
    title: string;
    institution: string;
    date: string;
}

const { title, institution, date } = Astro.props;
---

<div class="py-2.5">
    <div class="flex items-baseline justify-between gap-6">
        <h3
            class="min-w-0 text-[15px] font-semibold leading-snug text-cream-100 text-balance"
        >
            {title}
        </h3>
        <p
            class="shrink-0 font-mono text-[11px] tracking-[0.06em] text-cream-500 tabular-nums"
        >
            {date}
        </p>
    </div>
    <p class="mt-0.5 text-sm leading-relaxed text-cream-300">{institution}</p>
</div>
