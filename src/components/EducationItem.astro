---
export interface Props {
    title: string;
    institution: string;
    date: string;
}

const { title, institution, date } = Astro.props;
---

<div class="py-4">
    <div class="flex items-baseline gap-3">
        <h3
            class="min-w-0 text-[15px] font-semibold leading-snug text-cream-100 text-balance"
        >
            {title}
        </h3>
        <span
            aria-hidden="true"
            class="hidden min-w-8 flex-1 self-center border-b border-dotted border-cream-500/50 sm:block"
        ></span>
        <p
            class="shrink-0 font-mono text-[11px] uppercase tracking-[0.08em] text-cream-300 tabular-nums"
        >
            {date}
        </p>
    </div>
    <p
        class="mt-1 font-mono text-[11px] uppercase tracking-[0.14em] text-cream-500"
    >
        {institution}
    </p>
</div>
