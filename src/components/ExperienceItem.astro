---
export interface Props {
    title: string;
    employer: string;
    date: string;
}

const { title, employer, date } = Astro.props;
---

<div>
    <h4 class="font-bold">{title}</h4>
    <div class="flex justify-between text-sm italic">
        <p class="italic">{employer}</p>
        <p>{date}</p>
    </div>
</div>
