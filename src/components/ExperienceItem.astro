---
export interface Props {
    title: string;
    employer: string;
    date: string;
}

const { title, employer, date } = Astro.props;
---

<div class="flex items-baseline justify-between gap-6 py-2.5">
    <div class="min-w-0">
        <h3
            class="text-[15px] font-semibold leading-snug text-cream-100 text-balance"
        >
            {title}
        </h3>
        <p class="mt-0.5 text-sm leading-relaxed text-cream-300">{employer}</p>
    </div>
    <p
        class="shrink-0 font-mono text-[11px] tracking-[0.06em] text-cream-500 tabular-nums"
    >
        {date}
    </p>
</div>
