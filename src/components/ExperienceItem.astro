---
export interface Props {
    title: string;
    employer: string;
    date: string;
}

const { title, employer, date } = Astro.props;
---

<div>
    <h3 class="text-[15px] leading-snug font-semibold text-cream-100">
        {title}
    </h3>
    <div class="flex items-baseline justify-between gap-3 text-sm">
        <p class="leading-relaxed text-cream-300">{employer}</p>
        <p
            class="shrink-0 font-mono text-[11px] tracking-[0.04em] text-cream-500 tabular-nums"
        >
            {date}
        </p>
    </div>
</div>
