---
import { Moon, Sun } from "lucide-astro";
---

<button
    type="button"
    class="theme-toggle"
    aria-label="Cambiar entre tema claro y oscuro"
    title="Tema claro / oscuro"
    data-theme-toggle
>
    <Moon class="icon-moon" size={18} aria-hidden="true" />
    <Sun class="icon-sun" size={18} aria-hidden="true" />
</button>

<script>
    const root = document.documentElement;
    const button = document.querySelector<HTMLButtonElement>("[data-theme-toggle]");

    function apply(theme: "light" | "dark") {
        root.dataset.theme = theme;
        try {
            localStorage.setItem("theme", theme);
        } catch {
            /* private mode: the choice just lasts for this page */
        }
        document
            .querySelectorAll('meta[name="theme-color"]:not([media])')
            .forEach((meta) =>
                meta.setAttribute("content", theme === "light" ? "#fbf5e8" : "#0c0a07"),
            );
        window.dispatchEvent(new CustomEvent("themechange", { detail: theme }));
    }

    button?.addEventListener("click", () =>
        apply(root.dataset.theme === "light" ? "dark" : "light"),
    );
</script>
