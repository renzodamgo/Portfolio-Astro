---
import { ArrowUpRight } from "lucide-astro";

export interface Props {
    title: string;
    description: string;
    github_link: string;
}

const { title, description, github_link } = Astro.props;
---

<article class="group py-5">
    <a
        href={github_link}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-start justify-between gap-4 rounded-sm"
    >
        <h4
            class="font-display text-[22px] leading-tight font-medium text-cream-100 text-balance transition-colors duration-200 group-hover:text-amber-300"
        >
            {title}
        </h4>
        <span
            class="mt-1 grid size-8 shrink-0 place-items-center rounded-full border border-line text-cream-400 transition-all duration-200 group-hover:border-amber-400 group-hover:bg-amber-400 group-hover:text-coal-950"
            aria-hidden="true"
        >
            <ArrowUpRight size={16} />
        </span>
    </a>
    <p class="mt-2 max-w-[62ch] text-sm leading-relaxed text-cream-300">
        {description}
    </p>
    <p
        class="mt-2 font-mono text-[11px] uppercase tracking-[0.08em] text-cream-500"
    >
        <span class="sr-only">Repository: </span>GitHub
    </p>
</article>
