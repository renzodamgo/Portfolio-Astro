---
export interface Props {
    title: string;
    description: string;
    github_link: string;
}

const { title, description, github_link } = Astro.props;
---

<div>
    <h3 class="text-[15px] leading-snug font-semibold text-cream-100">
        <a
            href={github_link}
            target="_blank"
            rel="noopener noreferrer"
            class="transition-colors duration-200 hover:text-amber-300"
            >{title}</a
        >
    </h3>
    <p class="mt-0.5 text-sm leading-relaxed text-cream-300">{description}</p>
    <a
        class="mt-1 inline-block font-mono text-[11px] tracking-[0.08em] text-cream-500 uppercase transition-colors duration-200 hover:text-amber-300"
        href={github_link}
        target="_blank"
        rel="noopener noreferrer">Github ↗</a
    >
</div>
