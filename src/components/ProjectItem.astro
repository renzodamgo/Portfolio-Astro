---
export interface Props {
    title: string;
    description: string;
    github_link: string;
}

const { title, description, github_link } = Astro.props;
---

<div>
    <h4 class="font-bold">{title}</h4>
    <div class="flex flex-col text-sm">
        <p class="italic">{description}</p>
        <a
            class="pt-1 font-bold underline"
            href={github_link}
            target="_blank"
            rel="noopener noreferrer">Github</a
        >
    </div>
</div>
