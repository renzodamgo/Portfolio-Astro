---
/**
 * Drivable Robotek car on the Open Challenge field (Three.js, lazy). Mount as <CarSim />.
 * JS API on the root element: el.__carSim = { setDirection, reset, getPose, onTick }.
 */
interface Props {
    /** Smaller canvas, fewer HUD lines, for embedding inside a guide step. */
    compact?: boolean;
    /** Skip the dimmed "haz clic para conducir" cover (a small hint chip is shown instead). */
    autostart?: boolean;
}
const { compact = false, autostart = false } = Astro.props;
---

<div
    class="car-sim"
    data-car-sim
    data-compact={compact ? "true" : "false"}
    data-autostart={autostart ? "true" : "false"}
    data-focused="false"
>
    <div
        class="cs-viewport"
        tabindex="0"
        role="application"
        aria-label="Simulador del coche Robotek. Haz clic para conducir con el teclado; Escape para salir."
    >
        <canvas class="cs-canvas"></canvas>
        <div class="cs-hit"></div>
        <pre class="cs-hud" aria-hidden="true"></pre>
        <div class="cs-camlabel" aria-hidden="true"><span>cámara del coche · 640×480</span></div>
        <p class="cs-loading">Cargando el coche…</p>
        <div class="cs-cover" aria-hidden="true">
            <span class="cs-cover-chip">Haz clic para conducir</span>
        </div>
        <div class="cs-touch">
            <div class="cs-pad cs-pad-left">
                <button type="button" tabindex="-1" data-touch="left" aria-label="Girar a la izquierda">←</button>
                <button type="button" tabindex="-1" data-touch="right" aria-label="Girar a la derecha">→</button>
            </div>
            <button type="button" tabindex="-1" class="cs-reset" data-touch="reset" aria-label="Reiniciar">R</button>
            <div class="cs-pad cs-pad-right">
                <button type="button" tabindex="-1" data-touch="up" aria-label="Acelerar">↑</button>
                <button type="button" tabindex="-1" data-touch="down" aria-label="Reversa">↓</button>
            </div>
        </div>
    </div>
    <p class="cs-keys">
        <kbd>W A S D</kbd> o flechas conducir · <kbd>Espacio</kbd> freno · <kbd>L</kbd> LiDAR ·
        <kbd>C</kbd> cámara · <kbd>V</kbd> vista · <kbd>T</kbd> límite del volante · <kbd>R</kbd> reiniciar ·
        <kbd>Esc</kbd> salir
    </p>
</div>

<style>
    .car-sim {
        /* The stage colours come from learn-widgets.css (--stage-*): white in the light theme, black in the dark one */
        --cs-bg: var(--stage-bg, #000);
        --cs-amber: var(--stage-accent-line, #e8a33d);
        --cs-amber-soft: var(--stage-accent, #f2b95c);
        --cs-line: var(--btn-border, #8d8069);
        --cs-text: var(--stage-fg, #f5eee1);
        --cs-muted: var(--stage-muted, #b3a488);
        --cs-chip: var(--stage-chip-bg, rgb(0 0 0 / 0.78));
        --cs-chip-line: var(--stage-chip-border, rgb(245 238 225 / 0.3));
        width: 100%;
        color: var(--cs-text);
    }
    .cs-viewport {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        min-height: 320px;
        max-height: 78vh;
        overflow: hidden;
        background: var(--cs-bg);
        border: 1px solid var(--cs-line);
        border-radius: 10px;
        outline: none;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .car-sim[data-compact="true"] .cs-viewport {
        aspect-ratio: 16 / 10;
        min-height: 240px;
        max-height: 340px;
    }
    .car-sim[data-focused="true"] .cs-viewport {
        border-color: var(--cs-amber);
        box-shadow: 0 0 0 1px var(--cs-amber);
    }
    .cs-viewport:focus-visible {
        outline: 2px solid var(--cs-amber);
        outline-offset: 3px;
    }
    .cs-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }
    .cs-hit {
        position: absolute;
        inset: 0;
        background: #e33;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s;
    }
    .cs-hud {
        position: absolute;
        top: 10px;
        left: 10px;
        margin: 0;
        padding: 8px 12px;
        background: var(--cs-chip);
        border: 1px solid var(--cs-chip-line);
        border-radius: 6px;
        color: var(--cs-text);
        font: 12px/1.5 ui-monospace, Menlo, Consolas, monospace;
        white-space: pre;
        pointer-events: none;
        z-index: 2; /* above the dimmed cover: the numbers stay crisp */
    }
    .car-sim[data-compact="true"] .cs-hud {
        top: 8px;
        left: 8px;
        padding: 6px 9px;
        font-size: 11px;
    }
    .car-sim[data-tight="true"] .cs-hud {
        top: 6px;
        left: 6px;
        padding: 4px 7px;
        font-size: 10px;
    }
    .cs-hud:empty {
        display: none;
    }
    .cs-camlabel {
        position: absolute;
        box-sizing: border-box;
        border: 2px solid var(--cs-amber);
        border-radius: 4px;
        pointer-events: none;
        z-index: 2;
    }
    .cs-camlabel[hidden] {
        display: none;
    }
    .cs-camlabel span {
        position: absolute;
        left: 0;
        top: 0;
        padding: 2px 8px;
        background: var(--cs-chip);
        color: var(--cs-amber-soft);
        font: 11px/1.4 ui-monospace, Menlo, Consolas, monospace;
        border-bottom-right-radius: 4px;
        white-space: nowrap;
    }
    .cs-loading {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        margin: 0;
        background: var(--cs-bg);
        color: var(--cs-muted);
        font-size: 14px;
        z-index: 3;
    }
    .cs-loading[hidden] {
        display: none;
    }
    .cs-cover {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: var(--stage-dim, rgb(0 0 0 / 0.55));
        pointer-events: none;
        transition: opacity 0.2s;
    }
    .cs-cover-chip {
        padding: 10px 18px;
        border: 1px solid var(--cs-amber);
        border-radius: 999px;
        background: var(--cs-chip);
        color: var(--cs-amber-soft);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.02em;
    }
    .car-sim[data-focused="true"] .cs-cover {
        opacity: 0;
    }
    /* autostart: no dimming, only a small chip at the bottom while the canvas has no focus */
    .car-sim[data-autostart="true"] .cs-cover {
        background: transparent;
        place-items: end center;
        padding-bottom: 14px;
    }
    .cs-touch {
        position: absolute;
        inset: auto 0 0 0;
        display: none;
        justify-content: space-between;
        align-items: flex-end;
        padding: 10px;
        pointer-events: none;
    }
    @media (pointer: coarse) {
        .cs-touch {
            display: flex;
        }
        .cs-cover-chip {
            display: none;
        }
        .cs-keys {
            display: none;
        }
    }
    .cs-pad {
        display: flex;
        gap: 10px;
    }
    .cs-pad-right {
        flex-direction: column;
    }
    .cs-touch button {
        pointer-events: auto;
        width: 56px;
        height: 56px;
        border: 2px solid var(--cs-amber);
        border-radius: 12px;
        background: var(--cs-chip);
        color: var(--cs-amber-soft);
        font-size: 24px;
        line-height: 1;
        touch-action: none;
        -webkit-tap-highlight-color: transparent;
    }
    .cs-touch button[data-active="true"] {
        background: var(--btn-primary-bg, #e8a33d);
        color: var(--btn-primary-fg, #0c0a07);
    }
    .cs-touch .cs-reset {
        width: 40px;
        height: 40px;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .cs-keys {
        margin: 10px 2px 0;
        color: var(--cs-muted);
        font-size: 13px;
        line-height: 1.9;
    }
    .cs-keys kbd {
        padding: 1px 6px;
        border: 1px solid var(--cs-line);
        border-bottom-width: 2px;
        border-radius: 4px;
        background: var(--stage-key-bg, #17130d);
        color: var(--cs-amber-soft);
        font: 12px ui-monospace, Menlo, Consolas, monospace;
    }
    .car-sim[data-compact="true"] .cs-keys {
        font-size: 12px;
    }
</style>

<script>
    import { mountAllCarSims } from "../../scripts/learn/car-sim";

    mountAllCarSims();
    document.addEventListener("astro:page-load", mountAllCarSims);
</script>
