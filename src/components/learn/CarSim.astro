---
/**
 * Drivable Robotek car on the Open Challenge field (Three.js, lazy). Mount as <CarSim />.
 * JS API on the root element: el.__carSim = { setDirection, reset, getPose, onTick }.
 * With `challenge` it also shows the Reto panel (timer, laps, sections, crashes, best round, finish card), configured
 * by the URL: ?paso=1..9 and ?dir=ccw|cw (see scripts/learn/car-sim/challenge.ts).
 */
interface Props {
    /** Smaller canvas, fewer HUD lines, for embedding inside a guide step. */
    compact?: boolean;
    /** Skip the dimmed "haz clic para conducir" cover (a small hint chip is shown instead). */
    autostart?: boolean;
    /** Manual challenge mode: the Reto panel above the canvas and the finish card over it. */
    challenge?: boolean;
    /** Race mode (step 0 of the guides): driver and car colour, countdown, 3 laps against the clock, local ranking.
     * "obstacle" adds the traffic signs of the Obstacle guide (layout 4). See scripts/learn/car-sim/race.ts. */
    race?: "open" | "obstacle";
}
const { compact = false, autostart = false, challenge = false, race } = Astro.props;
---

<div
    class="car-sim"
    data-car-sim
    data-compact={compact ? "true" : "false"}
    data-autostart={autostart ? "true" : "false"}
    data-challenge={challenge ? "true" : "false"}
    data-race={race}
    data-field={race === "obstacle" ? "obstacle" : undefined}
    data-focused="false"
>
    {
        challenge && (
            <section class="csc" data-csc="panel" aria-label="Reto">
                <div class="csc-head">
                    <h2 class="csc-title" data-csc="title">Reto</h2>
                    <a class="csc-back" data-csc="back" href="/learn/open-strategy/" hidden>
                        Volver a la guía
                    </a>
                    <span class="csc-spacer" />
                    <div class="csc-dirbox" data-csc="dirbox">
                        <span class="csc-dirlabel" data-csc="dirlabel">Sentido: antihorario</span>
                        <button type="button" class="csc-btn" data-csc-dir="ccw" aria-pressed="true">
                            Antihorario
                        </button>
                        <button type="button" class="csc-btn" data-csc-dir="cw" aria-pressed="false">
                            Horario
                        </button>
                    </div>
                    <button type="button" class="csc-btn csc-reset" data-csc="reset">
                        Reiniciar (R)
                    </button>
                </div>
                <p class="csc-text" data-csc="text" />
                <p class="csc-speed" data-csc="speed">Velocidad máxima: 0,6 m/s, como el coche real.</p>
                <div class="csc-guess" data-csc="guess" role="group" aria-label="Adivina el sentido" hidden>
                    <p class="csc-guess-hint" data-csc="guess-hint">
                        Elige el sentido para poder arrancar. La cámara (tecla C) muestra lo único que ve el código.
                    </p>
                    <div class="csc-guess-buttons">
                        <button type="button" class="csc-btn" data-csc-guess="ccw" aria-pressed="false">
                            Líneas azules más largas: antihorario
                        </button>
                        <button type="button" class="csc-btn" data-csc-guess="cw" aria-pressed="false">
                            Líneas naranjas más largas: horario
                        </button>
                        <button type="button" class="csc-btn csc-skip" data-csc-guess="skip">Saltar</button>
                    </div>
                </div>
                <div class="csc-stats">
                    <div class="csc-stat csc-stat-time">
                        <span class="csc-label">Tiempo</span>
                        <span class="csc-value csc-big" data-csc="time">0,0 s</span>
                    </div>
                    <div class="csc-stat">
                        <span class="csc-label">Vueltas</span>
                        <span class="csc-value" data-csc="laps">0/3</span>
                    </div>
                    <div class="csc-stat">
                        <span class="csc-label">Secciones</span>
                        <span class="csc-value" data-csc="sections">0/24</span>
                    </div>
                    <div class="csc-stat">
                        <span class="csc-label">Choques</span>
                        <span class="csc-value" data-csc="crashes">0</span>
                    </div>
                    <div class="csc-stat csc-stat-best">
                        <span class="csc-label" data-csc="bestlabel">Mejor ronda</span>
                        <span class="csc-value csc-small" data-csc="best">ninguna todavía</span>
                    </div>
                </div>
                <div class="csc-reads">
                    <div class="csc-read" data-read="steer" hidden>
                        <span class="csc-label">Volante</span>
                        <span class="csc-value" data-csc="steer">0,0°</span>
                    </div>
                    <div class="csc-read" data-read="limit" hidden>
                        <span class="csc-label">Límite (tecla T)</span>
                        <span class="csc-value" data-csc="limit" />
                    </div>
                    <div class="csc-read" data-read="radius" hidden>
                        <span class="csc-label">Radio de giro</span>
                        <span class="csc-value" data-csc="radius">recto</span>
                    </div>
                    <div class="csc-read" data-read="heading" hidden>
                        <span class="csc-label">Rumbo del giroscopio</span>
                        <span class="csc-value" data-csc="heading">0°</span>
                    </div>
                    <div class="csc-read" data-read="left" hidden>
                        <span class="csc-label">Izquierda</span>
                        <span class="csc-value" data-csc="left">-</span>
                    </div>
                    <div class="csc-read" data-read="right" hidden>
                        <span class="csc-label">Derecha</span>
                        <span class="csc-value" data-csc="right">-</span>
                    </div>
                    <div class="csc-read" data-read="front" hidden>
                        <span class="csc-label">Frente</span>
                        <span class="csc-value" data-csc="front">-</span>
                    </div>
                    <div class="csc-read" data-read="gap" hidden>
                        <span class="csc-label">Hueco a la isla</span>
                        <span class="csc-value" data-csc="gap" data-ok="false">-</span>
                    </div>
                    <div class="csc-read" data-read="band" hidden>
                        <span class="csc-label">Dentro de la banda</span>
                        <span class="csc-value" data-csc="band">0,0 s</span>
                    </div>
                    <div class="csc-read" data-read="turn" hidden>
                        <span class="csc-label">Empezaste a girar a</span>
                        <span class="csc-value" data-csc="turn">todavía no giraste</span>
                    </div>
                </div>
                <div class="csc-gauge" data-csc="gauge" hidden>
                    <div class="csc-gauge-track">
                        <div class="csc-gauge-band" />
                        <div class="csc-gauge-marker" data-csc="marker" />
                    </div>
                    <div class="csc-gauge-scale" aria-hidden="true">
                        <span>0</span>
                        <span>banda verde: 0,20 a 0,30 m</span>
                        <span>0,60 m</span>
                    </div>
                </div>
                <p class="csc-sr" role="status" aria-live="polite" data-csc="live" />
            </section>
        )
    }
    {
        race && (
            <section class="csc csr" data-csr="panel" aria-label="Carrera">
                <div class="csc-head">
                    <h2 class="csc-title">{race === "obstacle" ? "Carrera con señales" : "Carrera"}</h2>
                    <span class="csr-driver" data-csr="driver" />
                    <span class="csc-spacer" />
                    <button type="button" class="csc-btn csc-reset" data-csr="change">Cambiar piloto</button>
                </div>
                <p class="csc-speed" data-csr="speed" />
                <div class="csc-stats">
                    <div class="csc-stat csr-stat-lap">
                        <span class="csc-label">Vuelta</span>
                        <span class="csc-value csc-big" data-csr="lap">1 de 3</span>
                    </div>
                    <div class="csc-stat csc-stat-time">
                        <span class="csc-label">Tiempo</span>
                        <span class="csc-value csc-big" data-csr="time">0,0 s</span>
                    </div>
                    <div class="csc-stat">
                        <span class="csc-label">Secciones</span>
                        <span class="csc-value" data-csr="sections">0/24</span>
                    </div>
                    <div class="csc-stat">
                        <span class="csc-label">Choques</span>
                        <span class="csc-value" data-csr="crashes">0</span>
                    </div>
                    <div class="csc-stat" data-csr="wrong-stat" hidden>
                        <span class="csc-label">Señales mal pasadas</span>
                        <span class="csc-value" data-csr="wrong">0</span>
                    </div>
                </div>
                <p class="csc-sr" role="status" aria-live="polite" data-csr="live" />
            </section>
        )
    }
    <div
        class="cs-viewport"
        tabindex="0"
        role="application"
        aria-label="Simulador del coche Robotek. Haz clic para conducir con el teclado; Escape para salir."
    >
        <canvas class="cs-canvas"></canvas>
        <div class="cs-hit"></div>
        <pre class="cs-hud" aria-hidden="true"></pre>
        <div class="cs-camlabel" aria-hidden="true"><span>cámara del coche · 640×480</span></div>
        <p class="cs-loading">Cargando el coche…</p>
        <div class="cs-cover" aria-hidden="true">
            <span class="cs-cover-chip">Haz clic para conducir</span>
        </div>
        {
            race && (
                <div class="csr-setup" data-csr="setup">
                    <h3 class="csf-title">Tu piloto</h3>
                    <label class="csr-field">
                        <span>Nombre</span>
                        <input type="text" maxlength="20" placeholder="Piloto" data-csr="name" autocomplete="nickname" />
                    </label>
                    <div class="csr-row"><span>Piel</span><div class="csr-swatches" data-csr-swatches="skin" /></div>
                    <div class="csr-row"><span>Pelo</span><div class="csr-swatches" data-csr-swatches="hair" /></div>
                    <div class="csr-row"><span>Polo</span><div class="csr-swatches" data-csr-swatches="shirt" /></div>
                    <div class="csr-row"><span>Coche</span><div class="csr-swatches" data-csr-swatches="car" /></div>
                    <div class="csr-row">
                        <span>Salida</span>
                        <div class="csr-swatches">
                            <button type="button" class="csc-btn" data-csr-dir="ccw" aria-pressed="true">Antihorario</button>
                            <button type="button" class="csc-btn" data-csr-dir="cw" aria-pressed="false">Horario</button>
                        </div>
                    </div>
                    <p class="csr-hint">Teclas: W o flecha arriba para acelerar, A y D para girar, S para frenar.</p>
                    <button type="button" class="csc-btn csr-go" data-csr="start">¡A correr!</button>
                </div>
                <div class="csr-count" data-csr="count" aria-hidden="true" hidden>3</div>
                <div class="csr-penalty" data-csr="penalty" aria-hidden="true" hidden>+2 s</div>
                <div class="cs-finish csr-finish" data-csr="finish" hidden>
                    <h3 class="csf-title">¡Meta!</h3>
                    <p class="csr-final" data-csr="final">0,0 s</p>
                    <p class="csf-line" data-csr="breakdown" />
                    <p class="csf-line" data-csr="place" />
                    <ol class="csr-ranking" data-csr="ranking" />
                    <p class="csf-note" data-csr="ranking-empty" hidden>Todavía no hay tiempos en este navegador.</p>
                    <div class="csr-actions">
                        <button type="button" class="csc-btn csr-go" data-csr="again">Otra vez</button>
                        <button type="button" class="csc-btn" data-csr="copy">Copiar resultado</button>
                    </div>
                    <p class="csf-note" data-csr="copied">Compártelo: gana el menor tiempo con penalizaciones.</p>
                </div>
            )
        }
        {
            challenge && (
                <p class="cs-lockmsg" data-csc="lockmsg" aria-hidden="true" hidden>
                    Elige el sentido para arrancar
                </p>
            )
        }
        {
            challenge && (
                <div class="cs-finish" data-csc="finish" hidden>
                    <h3 class="csf-title">Ronda terminada</h3>
                    <p class="csf-line" data-csc="finish-line" />
                    <p class="csf-extra" data-csc="finish-extra" />
                    <p class="csf-note">Es una estimación, no la puntuación oficial.</p>
                    <button type="button" class="csc-btn" data-csc="again">
                        Reiniciar (R)
                    </button>
                </div>
            )
        }
        <div class="cs-touch">
            <div class="cs-pad cs-pad-left">
                <button type="button" tabindex="-1" data-touch="left" aria-label="Girar a la izquierda">←</button>
                <button type="button" tabindex="-1" data-touch="right" aria-label="Girar a la derecha">→</button>
            </div>
            <button type="button" tabindex="-1" class="cs-reset" data-touch="reset" aria-label="Reiniciar">R</button>
            <div class="cs-pad cs-pad-right">
                <button type="button" tabindex="-1" data-touch="up" aria-label="Acelerar">↑</button>
                <button type="button" tabindex="-1" data-touch="down" aria-label="Reversa">↓</button>
            </div>
        </div>
    </div>
    <p class="cs-keys">
        <kbd>W A S D</kbd> o flechas conducir · <kbd>Espacio</kbd> freno · <kbd>L</kbd> LiDAR ·
        <kbd>C</kbd> cámara · <kbd>V</kbd> vista · <kbd>T</kbd> límite del volante · <kbd>R</kbd> reiniciar ·
        <kbd>Esc</kbd> salir
    </p>
</div>

<style>
    .car-sim {
        /* The stage colours come from learn-widgets.css (--stage-*): white in the light theme, black in the dark one */
        --cs-bg: var(--stage-bg, #000);
        --cs-amber: var(--stage-accent-line, #e8a33d);
        --cs-amber-soft: var(--stage-accent, #f2b95c);
        --cs-line: var(--btn-border, #8d8069);
        --cs-text: var(--stage-fg, #f5eee1);
        --cs-muted: var(--stage-muted, #b3a488);
        --cs-chip: var(--stage-chip-bg, rgb(0 0 0 / 0.78));
        --cs-chip-line: var(--stage-chip-border, rgb(245 238 225 / 0.3));
        width: 100%;
        color: var(--cs-text);
    }
    .cs-viewport {
        position: relative;
        width: 100%;
        aspect-ratio: 16 / 9;
        min-height: 320px;
        max-height: 70vh;
        overflow: hidden;
        background: var(--cs-bg);
        border: 1px solid var(--cs-line);
        border-radius: 10px;
        outline: none;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
        transition: border-color 0.2s, box-shadow 0.2s;
    }
    .car-sim[data-compact="true"] .cs-viewport {
        aspect-ratio: 16 / 10;
        min-height: 240px;
        max-height: 340px;
    }
    .car-sim[data-focused="true"] .cs-viewport {
        border-color: var(--cs-amber);
        box-shadow: 0 0 0 1px var(--cs-amber);
    }
    .cs-viewport:focus-visible {
        outline: 2px solid var(--cs-amber);
        outline-offset: 3px;
    }
    .cs-canvas {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        display: block;
    }
    .cs-hit {
        position: absolute;
        inset: 0;
        background: #e33;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.25s;
    }
    .cs-hud {
        position: absolute;
        top: 10px;
        left: 10px;
        margin: 0;
        padding: 8px 12px;
        background: var(--cs-chip);
        border: 1px solid var(--cs-chip-line);
        border-radius: 6px;
        color: var(--cs-text);
        font: 12px/1.5 ui-monospace, Menlo, Consolas, monospace;
        white-space: pre;
        pointer-events: none;
        z-index: 2; /* above the dimmed cover: the numbers stay crisp */
    }
    .car-sim[data-compact="true"] .cs-hud {
        top: 8px;
        left: 8px;
        padding: 6px 9px;
        font-size: 11px;
    }
    .car-sim[data-tight="true"] .cs-hud {
        top: 6px;
        left: 6px;
        padding: 4px 7px;
        font-size: 10px;
    }
    .cs-hud:empty {
        display: none;
    }
    .cs-camlabel {
        position: absolute;
        box-sizing: border-box;
        border: 2px solid var(--cs-amber);
        border-radius: 4px;
        pointer-events: none;
        z-index: 2;
    }
    .cs-camlabel[hidden] {
        display: none;
    }
    .cs-camlabel span {
        position: absolute;
        left: 0;
        top: 0;
        padding: 2px 8px;
        background: var(--cs-chip);
        color: var(--cs-amber-soft);
        font: 11px/1.4 ui-monospace, Menlo, Consolas, monospace;
        border-bottom-right-radius: 4px;
        white-space: nowrap;
    }
    .cs-loading {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        margin: 0;
        background: var(--cs-bg);
        color: var(--cs-muted);
        font-size: 14px;
        z-index: 3;
    }
    .cs-loading[hidden] {
        display: none;
    }
    .cs-cover {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        background: var(--stage-dim, rgb(0 0 0 / 0.55));
        pointer-events: none;
        transition: opacity 0.2s;
    }
    .cs-cover-chip {
        padding: 10px 18px;
        border: 1px solid var(--cs-amber);
        border-radius: 999px;
        background: var(--cs-chip);
        color: var(--cs-amber-soft);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.02em;
    }
    .car-sim[data-focused="true"] .cs-cover {
        opacity: 0;
    }
    /* autostart: no dimming, only a small chip at the bottom while the canvas has no focus */
    .car-sim[data-autostart="true"] .cs-cover {
        background: transparent;
        place-items: end center;
        padding-bottom: 14px;
    }
    .cs-touch {
        position: absolute;
        inset: auto 0 0 0;
        display: none;
        justify-content: space-between;
        align-items: flex-end;
        padding: 10px;
        pointer-events: none;
    }
    @media (pointer: coarse) {
        .cs-touch {
            display: flex;
        }
        .cs-cover-chip {
            display: none;
        }
        .cs-keys {
            display: none;
        }
    }
    .cs-pad {
        display: flex;
        gap: 10px;
    }
    .cs-pad-right {
        flex-direction: column;
    }
    .cs-touch button {
        pointer-events: auto;
        width: 56px;
        height: 56px;
        border: 2px solid var(--cs-amber);
        border-radius: 12px;
        background: var(--cs-chip);
        color: var(--cs-amber-soft);
        font-size: 24px;
        line-height: 1;
        touch-action: none;
        -webkit-tap-highlight-color: transparent;
    }
    .cs-touch button[data-active="true"] {
        background: var(--btn-primary-bg, #e8a33d);
        color: var(--btn-primary-fg, #0c0a07);
    }
    .cs-touch .cs-reset {
        width: 40px;
        height: 40px;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 8px;
    }
    .cs-keys {
        margin: 10px 2px 0;
        color: var(--cs-muted);
        font-size: 13px;
        line-height: 1.9;
    }
    .cs-keys kbd {
        padding: 1px 6px;
        border: 1px solid var(--cs-line);
        border-bottom-width: 2px;
        border-radius: 4px;
        background: var(--stage-key-bg, #17130d);
        color: var(--cs-amber-soft);
        font: 12px ui-monospace, Menlo, Consolas, monospace;
    }
    .car-sim[data-compact="true"] .cs-keys {
        font-size: 12px;
    }

    /* ---- Challenge mode: Reto panel above the canvas, finish card over it ---- */
    .car-sim {
        --cs-good: #6fd3a0;
        --cs-bad: var(--stage-error, #ff9d8f);
        --cs-panel: color-mix(in oklab, var(--cs-text) 6%, transparent);
    }
    :global(html[data-theme="light"]) .car-sim {
        --cs-good: #1c7a4c;
    }
    .csc {
        margin-bottom: 12px;
        padding: 12px 14px;
        border: 1px solid var(--cs-line);
        border-radius: 10px;
        background: var(--cs-panel);
    }
    .csc-head {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px 12px;
    }
    .csc-title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: var(--cs-amber-soft);
    }
    .csc-back {
        color: var(--cs-amber-soft);
        font-size: 13px;
        text-decoration: underline;
        text-underline-offset: 3px;
    }
    .csc-back[hidden] {
        display: none;
    }
    .csc-spacer {
        flex: 1 1 0;
    }
    .csc-dirbox {
        display: flex;
        align-items: center;
        gap: 6px;
    }
    .csc-dirbox[hidden] {
        display: none;
    }
    .csc-dirlabel {
        margin-right: 4px;
        color: var(--cs-muted);
        font-size: 13px;
    }
    .csc-btn {
        padding: 5px 12px;
        border: 1px solid var(--btn-border, var(--cs-line));
        border-radius: 8px;
        background: var(--btn-bg, transparent);
        color: var(--cs-text);
        font: inherit;
        font-size: 13px;
        cursor: pointer;
    }
    .csc-btn:hover {
        background: var(--btn-bg-hover, var(--cs-panel));
    }
    .csc-btn:focus-visible {
        outline: 2px solid var(--focus-ring, var(--cs-amber));
        outline-offset: 2px;
    }
    .csc-btn[aria-pressed="true"] {
        background: var(--btn-on-bg, var(--cs-panel));
        border-color: var(--btn-on-border, var(--cs-amber));
    }
    .csc-reset {
        background: var(--btn-primary-bg, #e8a33d);
        border-color: var(--btn-primary-bg, #e8a33d);
        color: var(--btn-primary-fg, #0c0a07);
        font-weight: 600;
    }
    .csc-reset:hover {
        background: var(--btn-primary-bg-hover, #f2b95c);
    }
    .csc-text {
        margin: 8px 0 12px;
        font-size: 15px;
        line-height: 1.5;
    }
    .csc-speed {
        margin: -4px 0 10px;
        color: var(--cs-muted);
        font-size: 13px;
    }
    .csc-guess {
        margin: 0 0 12px;
        padding: 8px 10px;
        border: 1px dashed var(--cs-amber);
        border-radius: 8px;
    }
    .csc-guess[hidden],
    .cs-lockmsg[hidden] {
        display: none;
    }
    .csc-guess-hint {
        margin: 0 0 8px;
        font-size: 14px;
    }
    .csc-guess-buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }
    .csc-btn:disabled {
        opacity: 0.6;
        cursor: default;
    }
