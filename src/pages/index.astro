---
import ExperienceItem from "../components/ExperienceItem.astro";
import ProjectItem from "../components/ProjectItem.astro";
import EducationItem from "../components/EducationItem.astro";
import Layout from "../layouts/Layout.astro";
import Renzo from "../assets/renzodamian-anatolianroverchallenge.webp";
import { Github, Linkedin, FileText, Mail, MapPin } from "lucide-astro";

export interface Experience {
    title: string;
    employer: string;
    date: string;
}

export interface Project {
    title: string;
    description: string;
    github_link: string;
}

const experiences: Experience[] = [
    {
        title: "AI Engineer",
        employer: "Mandü HR",
        date: "Aug 2026 – Present",
    },
    {
        title: "Software Team Lead",
        employer: "Marsworks",
        date: "Oct 2024 – Oct 2025",
    },
    {
        title: "Fullstack Java Developer",
        employer: "Bevertec",
        date: "Sep 2022 — Sep 2023",
    },
    {
        title: "Frontend Developer",
        employer: "Rebels 247",
        date: "Nov 2021 — Feb 2022",
    },
];

const involvements: Experience[] = [
    {
        title: "Co-Founder",
        employer: "BLK Robotics",
        date: "Dic 2023 — Present",
    },
    {
        title: "Programming Coach",
        employer: "Robotek",
        date: "Feb 2024 – Sep 2024",
    },
];

const projects: Project[] = [
    {
        title: "Scarab: Self-Driving Mars Rover",
        description:
            "Designed and implemented the autonomous navigation pipeline for the Marsworks Scarab rover using ROS2, RTAB-Map SLAM, and Nav2.",
        github_link: "https://github.com/SheffMarsworks/ScarabRover",
    },
    {
        title: "WRO 2024: Autonomous Driving Robot",
        description:
            "Ackermann robot designed to autonomously complete a circuit and evade obstacles using computer vision, 2D Lidar, and PID control with analog sensors.",
        github_link: "https://github.com/marieblasi/wro2024-robotek",
    },
    {
        title: "Drivesafe: Driver Drowsiness Detection",
        description:
            "An ML-powered app detecting driver drowsiness and distraction using computer vision. Integrates PyTorch with Apple’s Core ML, leveraging YOLOv8 for on-device inference.",
        github_link: "https://github.com/renzodamgo/Drivesafe",
    },
];

const education = [
    {
        title: "Master of Science in Advanced Computer Science",
        description:
            "Completed with Merit at the University of Sheffield. Dissertation: Multi-Target Speaker Extraction for Conversational Enhancement using Deep Learning for the CHiME-9 ECHI Challenge.",
        institution: "University of Sheffield",
        date: "Sep 2024 – Oct 2025",
    },
    {
        title: "Bachelor of Science in Computer Science",
        description:
            "Graduated with a GPA of 3.5/4.0 from Universidad Peruana de Ciencias Aplicadas (UPC) with concentrations in Machine Learning and Computer Vision.",
        institution: "Universidad Peruana de Ciencias Aplicadas (UPC)",
        date: "Jan 2018 – Jul 2023",
    },
];

const socials = [
    {
        label: "GitHub",
        href: "https://github.com/renzodamgo",
        Icon: Github,
    },
    {
        label: "LinkedIn",
        href: "https://linkedin.com/in/renzo-damian",
        Icon: Linkedin,
    },
    {
        label: "Resume (PDF)",
        href: "/Renzo_Damian_CV.pdf",
        Icon: FileText,
    },
    {
        label: "Email",
        href: "mailto:redamiangomez1@sheffield.ac.uk",
        Icon: Mail,
    },
];
---

<Layout>
    <a
        href="#about"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-amber-400 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-coal-950"
    >
        Skip to content
    </a>

    <main class="relative min-h-screen bg-coal-950 text-cream-100">
        <div
            class="pointer-events-none fixed inset-0"
            id="container"
            aria-hidden="true"
        >
        </div>
        <div
            class="pointer-events-none fixed inset-0"
            aria-hidden="true"
            style="background: radial-gradient(120% 90% at 50% 0%, transparent 30%, rgba(12,10,7,0.72) 68%, #0c0a07 100%), linear-gradient(to bottom, rgba(12,10,7,0.55), rgba(12,10,7,0.88));"
        >
        </div>

        <div class="relative mx-auto w-full max-w-[1160px] px-6 md:px-10">
            <header class="pt-14 md:pt-24">
                <h1
                    class="font-display max-w-[14ch] text-5xl leading-[1.02] font-medium tracking-[-0.02em] text-balance md:text-7xl"
                >
                    Renzo Damian
                </h1>
                <p
                    class="font-display mt-4 text-xl leading-snug text-cream-300 italic md:text-2xl"
                >
                    Software developer working in robotics and artificial
                    intelligence.
                </p>
                <p
                    class="mt-5 flex flex-wrap items-center gap-x-2 gap-y-1 font-mono text-[11px] uppercase tracking-[0.1em] text-cream-500"
                >
                    <MapPin size={14} aria-hidden="true" />
                    <span>Sheffield, UK</span>
                    <span aria-hidden="true" class="text-line">/</span>
                    <span>AI · Robotics · Full-stack</span>
                </p>

                <ul class="mt-7 flex flex-wrap items-center gap-3">
                    {
                        socials.map(({ label, href, Icon }) => (
                            <li>
                                <a
                                    href={href}
                                    target={
                                        href.startsWith("mailto:")
                                            ? undefined
                                            : "_blank"
                                    }
                                    rel={
                                        href.startsWith("mailto:")
                                            ? undefined
                                            : "noopener noreferrer"
                                    }
                                    aria-label={label}
                                    class="grid size-11 place-items-center rounded-full border border-line bg-coal-900/80 text-cream-300 transition-colors duration-200 hover:border-amber-400 hover:text-amber-300"
                                >
                                    <Icon size={18} />
                                </a>
                            </li>
                        ))
                    }
                    <li>
                        <a
                            href="/Renzo_Damian_CV.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex h-11 items-center gap-2 rounded-full bg-amber-400 px-5 text-sm font-medium text-coal-950 transition-colors duration-200 hover:bg-amber-300"
                        >
                            <FileText size={16} aria-hidden="true" />
                            Resume
                        </a>
                    </li>
                </ul>
            </header>

            <div class="mt-14 grid gap-12 pb-10 md:mt-20 lg:grid-cols-12 lg:gap-10">
                <aside class="lg:col-span-4">
                    <div class="lg:sticky lg:top-8">
                        <figure
                            class="overflow-hidden rounded-md border border-line bg-coal-900"
                        >
                            <img
                                class="aspect-[4/3] w-full object-cover grayscale"
                                src={Renzo.src}
                                alt="Renzo Damian with the Marsworks rover at the Anatolian Rover Challenge"
                                loading="eager"
                                fetchpriority="high"
                            />
                            <figcaption
                                class="border-t border-line px-4 py-3 font-mono text-[11px] leading-relaxed tracking-[0.04em] text-cream-500"
                            >
                                Anatolian Rover Challenge — Marsworks
                            </figcaption>
                        </figure>

                        <section
                            id="about"
                            aria-labelledby="about-heading"
                            class="mt-10 scroll-mt-8"
                        >
                            <h2
                                id="about-heading"
                                class="font-display border-t border-line pt-8 text-3xl font-medium tracking-[-0.01em] text-cream-100"
                            >
                                About
                            </h2>
                            <div
                                class="mt-5 max-w-[68ch] space-y-4 text-[15px] leading-[1.7] text-cream-300"
                            >
                                <p>
                                    I'm Renzo Damian, a software engineer based
                                    in Sheffield, focusing on robotics and
                                    artificial intelligence.
                                </p>
                                <p>
                                    Currently, I'm completing my Master's in
                                    Advanced Computer Science while leading the
                                    software team at{" "}
                                    <a
                                        target="_blank"
                                        class="text-cream-100 underline decoration-amber-400/70 underline-offset-4 transition-colors hover:text-amber-300"
                                        rel="noopener noreferrer"
                                        href="https://marsworks.sites.sheffield.ac.uk/"
                                        >Marsworks</a
                                    >, where I guide the development of
                                    autonomous navigation and mapping in
                                    preparation for the{" "}
                                    <a
                                        target="_blank"
                                        class="text-cream-100 underline decoration-amber-400/70 underline-offset-4 transition-colors hover:text-amber-300"
                                        rel="noopener noreferrer"
                                        href="https://www.anatolianrover.space/"
                                        >Anatolian Rover Challenge (ARC)</a
                                    >.
                                </p>
                                <p>
                                    Outside of work and university, I like to
                                    stay active by cycling. It's a great way to
                                    clear my head. I also enjoy reading,
                                    especially science fiction books like
                                    Asimov's stories, which first sparked my
                                    fascination with AI and robotics.
                                </p>
                            </div>
                        </section>
                    </div>
                </aside>

                <div class="lg:col-span-8">
                    <section aria-labelledby="experience-heading">
                        <h2
                            id="experience-heading"
                            class="font-display border-t border-line pt-8 text-3xl font-medium tracking-[-0.01em] text-cream-100"
                        >
                            Experience
                        </h2>
                        <div
                            class="mt-2 divide-y divide-line"
                        >
                            {
                                experiences.map((experience) => (
                                    <ExperienceItem
                                        title={experience.title}
                                        employer={experience.employer}
                                        date={experience.date}
                                    />
                                ))
                            }
                        </div>
                    </section>

                    <section
                        aria-labelledby="projects-heading"
                        class="mt-14"
                    >
                        <h2
                            id="projects-heading"
                            class="font-display border-t border-line pt-8 text-3xl font-medium tracking-[-0.01em] text-cream-100"
                        >
                            Projects
                        </h2>
                        <div class="mt-2 divide-y divide-line">
                            {
                                projects.map((project) => (
                                    <ProjectItem
                                        title={project.title}
                                        description={project.description}
                                        github_link={project.github_link}
                                    />
                                ))
                            }
                        </div>
                    </section>

                    <section
                        aria-labelledby="education-heading"
                        class="mt-14"
                    >
                        <h2
                            id="education-heading"
                            class="font-display border-t border-line pt-8 text-3xl font-medium tracking-[-0.01em] text-cream-100"
                        >
                            Education
                        </h2>
                        <div class="mt-2 divide-y divide-line">
                            {
                                education.map((item) => (
                                    <div class="py-4">
                                        <EducationItem
                                            title={item.title}
                                            institution={item.institution}
                                            date={item.date}
                                        />
                                        <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-cream-300">
                                            {item.description}
                                        </p>
                                    </div>
                                ))
                            }
                        </div>
                    </section>

                    <section
                        aria-labelledby="involvements-heading"
                        class="mt-14"
                    >
                        <h2
                            id="involvements-heading"
                            class="font-display border-t border-line pt-8 text-3xl font-medium tracking-[-0.01em] text-cream-100"
                        >
                            Involvements
                        </h2>
                        <div class="mt-2 divide-y divide-line">
                            {
                                involvements.map((involvement) => (
                                    <ExperienceItem
                                        title={involvement.title}
                                        employer={involvement.employer}
                                        date={involvement.date}
                                    />
                                ))
                            }
                        </div>
                    </section>
                </div>
            </div>

            <footer
                class="flex flex-wrap items-center justify-between gap-3 border-t border-line py-8 font-mono text-[11px] uppercase tracking-[0.1em] text-cream-500"
            >
                <p>Renzo Damian — Sheffield, UK</p>
                <p>Built with Astro · Three.js</p>
            </footer>
        </div>

        <script>
            import * as THREE from "three";
            import { OrbitControls } from "three/examples/jsm/controls/OrbitControls.js";
            interface SketchOptions {
                domElement: HTMLElement;
            }

            export default class Sketch {
                private container: HTMLElement;
                private width: number;
                private height: number;
                private camera: THREE.OrthographicCamera;
                private scene: THREE.Scene;
                private renderer: THREE.WebGLRenderer;
                private controls: OrbitControls;
                private time: number;
                private geometry!: THREE.BoxGeometry;
                private material!: THREE.MeshNormalMaterial;
                private mesh!: THREE.Mesh;
                private speedX: number = 0.0008;
                private speedY: number = 0.0008;
                private boundaryX: number = 0;
                private boundaryY: number = 0;
                private aspectRatio: number = 1;
                private running: boolean = true;
                private rafId: number = 0;

                constructor(options: SketchOptions) {
                    this.container = options.domElement;

                    // Get window dimensions
                    this.width = window.innerWidth;
                    this.height = window.innerHeight;
                    this.aspectRatio = this.width / this.height;

                    const frustumSize = 1;
                    this.camera = new THREE.OrthographicCamera(
                        (frustumSize * this.aspectRatio) / -2,
                        (frustumSize * this.aspectRatio) / 2,
                        frustumSize / 2,
                        frustumSize / -2,
                        0.01,
                        10,
                    );
                    this.camera.position.z = 1;

                    this.scene = new THREE.Scene();

                    this.renderer = new THREE.WebGLRenderer({
                        antialias: true,
                        alpha: true,
                    });
                    this.renderer.setPixelRatio(
                        Math.min(window.devicePixelRatio, 2),
                    );

                    this.renderer.setSize(this.width, this.height);

                    this.renderer.domElement.style.width = "100%";
                    this.renderer.domElement.style.height = "100%";
                    this.renderer.domElement.style.display = "block";
                    this.renderer.domElement.style.opacity = "0.35";

                    this.container.appendChild(this.renderer.domElement);
                    this.controls = new OrbitControls(
                        this.camera,
                        this.renderer.domElement,
                    );

                    this.controls.enabled = false;

                    this.time = 0;
                    this.resize();
                    this.addObjects();

                    const prefersReducedMotion = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;
                    if (prefersReducedMotion) {
                        this.renderer.render(this.scene, this.camera);
                    } else {
                        this.render();
                    }

                    this.setupResize();

                    document.addEventListener(
                        "visibilitychange",
                        () => {
                            if (document.hidden) {
                                this.running = false;
                                cancelAnimationFrame(this.rafId);
                            } else if (!prefersReducedMotion) {
                                if (!this.running) {
                                    this.running = true;
                                    this.render();
                                }
                            }
                        },
                    );
                }

                private resize(): void {
                    this.width = window.innerWidth;
                    this.height = window.innerHeight;
                    this.aspectRatio = this.width / this.height;

                    const frustumSize = 1;
                    this.camera.left = (frustumSize * this.aspectRatio) / -2;
                    this.camera.right = (frustumSize * this.aspectRatio) / 2;
                    this.camera.top = frustumSize / 2;
                    this.camera.bottom = frustumSize / -2;

                    this.renderer.setSize(this.width, this.height);
                    this.camera.updateProjectionMatrix();

                    this.boundaryX =
                        (frustumSize * this.aspectRatio) / 2 - 0.13;
                    this.boundaryY = frustumSize / 2 - 0.15;
                }

                private setupResize(): void {
                    window.addEventListener("resize", this.resize.bind(this));
                }

                private addObjects(): void {
                    this.geometry = new THREE.BoxGeometry(0.2, 0.2, 0.2);
                    this.material = new THREE.MeshNormalMaterial();

                    this.mesh = new THREE.Mesh(this.geometry, this.material);
                    // Start at a random position
                    this.mesh.position.x =
                        (Math.random() - 0.5) * this.boundaryX * 1.8;
                    this.mesh.position.y =
                        (Math.random() - 0.5) * this.boundaryY * 1.8;
                    this.scene.add(this.mesh);
                }

                private render(): void {
                    this.time += 1;

                    // Update rotation
                    this.mesh.rotation.x += 0.003;
                    this.mesh.rotation.y += 0.003;

                    // Update position
                    this.mesh.position.x += this.speedX;
                    this.mesh.position.y += this.speedY;

                    // Check for collisions with screen edges
                    // For X-axis
                    if (Math.abs(this.mesh.position.x) > this.boundaryX) {
                        this.speedX *= -1; // Reverse direction
                        this.mesh.position.x =
                            Math.sign(this.mesh.position.x) * this.boundaryX;
                    }

                    // For Y-axis
                    if (Math.abs(this.mesh.position.y) > this.boundaryY) {
                        this.speedY *= -1; // Reverse direction
                        this.mesh.position.y =
                            Math.sign(this.mesh.position.y) * this.boundaryY;
                    }

                    this.renderer.render(this.scene, this.camera);
                    this.rafId = requestAnimationFrame(
                        this.render.bind(this),
                    );
                }
            }

            new Sketch({
                domElement: document.getElementById("container") as HTMLElement,
            });
        </script>
    </main>
</Layout>
