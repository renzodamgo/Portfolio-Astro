---
import ExperienceItem from "../components/ExperienceItem.astro";
import ProjectItem from "../components/ProjectItem.astro";
import EducationItem from "../components/EducationItem.astro";
import Layout from "../layouts/Layout.astro";
import Renzo from "../assets/renzodamian-anatolianroverchallenge.webp";
import { Github, Linkedin, FileText, Mail, MapPin } from "lucide-astro";

export interface Experience {
    title: string;
    employer: string;
    date: string;
}

export interface Project {
    title: string;
    description: string;
    github_link: string;
}

const experiences: Experience[] = [
    {
        title: "AI Engineer",
        employer: "Mandü HR",
        date: "Aug 2026 – Present",
    },
    {
        title: "Software Team Lead",
        employer: "Marsworks",
        date: "Oct 2024 – Oct 2025",
    },
    {
        title: "Fullstack Java Developer",
        employer: "Bevertec",
        date: "Sep 2022 — Sep 2023",
    },
    {
        title: "Frontend Developer",
        employer: "Rebels 247",
        date: "Nov 2021 — Feb 2022",
    },
];

const involvements: Experience[] = [
    {
        title: "Co-Founder",
        employer: "BLK Robotics",
        date: "Dic 2023 — Present",
    },
    {
        title: "Programming Coach",
        employer: "Robotek",
        date: "Feb 2024 – Present",
    },
];

const projects: Project[] = [
    {
        title: "Scarab: Self-Driving Mars Rover",
        description:
            "Designed and implemented the autonomous navigation pipeline for the Marsworks Scarab rover using ROS2, RTAB-Map SLAM, and Nav2.",
        github_link: "https://github.com/SheffMarsworks/ScarabRover",
    },
    {
        title: "WRO 2024: Autonomous Driving Robot",
        description:
            "Ackermann robot designed to autonomously complete a circuit and evade obstacles using computer vision, 2D Lidar, and PID control with analog sensors.",
        github_link: "https://github.com/marieblasi/wro2024-robotek",
    },
    {
        title: "Drivesafe: Driver Drowsiness Detection",
        description:
            "An ML-powered app detecting driver drowsiness and distraction using computer vision. Integrates PyTorch with Apple’s Core ML, leveraging YOLOv8 for on-device inference.",
        github_link: "https://github.com/renzodamgo/Drivesafe",
    },
];

const education = [
    {
        title: "Master of Science in Advanced Computer Science",
        description:
            "Completed with Merit at the University of Sheffield. Dissertation: Multi-Target Speaker Extraction for Conversational Enhancement using Deep Learning for the CHiME-9 ECHI Challenge.",
        institution: "University of Sheffield",
        date: "Sep 2024 – Oct 2025",
    },
    {
        title: "Bachelor of Science in Computer Science",
        description:
            "Graduated with a GPA of 3.5/4.0 from Universidad Peruana de Ciencias Aplicadas (UPC) with concentrations in Machine Learning and Computer Vision.",
        institution: "Universidad Peruana de Ciencias Aplicadas (UPC)",
        date: "Jan 2018 – Jul 2023",
    },
];

const socials = [
    {
        label: "GitHub profile",
        href: "https://github.com/renzodamgo",
        Icon: Github,
    },
    {
        label: "LinkedIn profile",
        href: "https://linkedin.com/in/renzo-damian",
        Icon: Linkedin,
    },
    {
        label: "Download resume",
        href: "/Renzo_Damian_CV.pdf",
        Icon: FileText,
    },
    {
        label: "Contact me",
        href: "mailto:redamiangomez1@sheffield.ac.uk",
        Icon: Mail,
    },
];
---

<Layout>
    <a
        href="#about-me"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-amber-400 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-coal-950"
    >
        Skip to content
    </a>

    <main class="bg-black text-white">
        <div
            class="relative w-full text-white md:flex md:min-h-screen md:flex-col md:items-center md:justify-center"
        >
            <div
                class="relative mx-auto w-full max-w-[1200px] px-6 py-8 text-left md:my-0 md:py-10 lg:flex lg:gap-4"
            >
                <div
                    class="flex flex-col justify-end gap-4 border border-gray-700 p-4 backdrop-blur-2xl"
                >
                    <div class="overflow-hidden">
                        <img
                            class="aspect-[4/3] w-full object-cover grayscale"
                            src={Renzo.src}
                            width={800}
                            height={533}
                            alt="Renzo Damian with the Marsworks rover at the Anatolian Rover Challenge"
                            loading="eager"
                            fetchpriority="high"
                        />
                    </div>
                    <div class="flex flex-col md:flex-row md:justify-between md:gap-6">
                        <div class="grid gap-2">
                            <h1
                                class="text-4xl font-semibold"
                            >
                                Renzo Damian
                            </h1>
                            <div class="flex gap-1">
                                <MapPin size={18} aria-hidden="true" />
                                <p>Lima, Peru</p>
                            </div>
                            <h2 class="pb-4 text-xl md:pb-0">
                                AI Engineer — Mandü HR
                            </h2>
                        </div>
                        <div class="flex items-end">
                            <ul class="flex gap-4 md:pb-1">
                                {
                                    socials.map(({ label, href, Icon }) => (
                                        <li>
                                            <a
                                                href={href}
                                                aria-label={label}
                                                target={
                                                    href.startsWith("mailto:")
                                                        ? undefined
                                                        : "_blank"
                                                }
                                                rel={
                                                    href.startsWith("mailto:")
                                                        ? undefined
                                                        : "noopener noreferrer"
                                                }
                                                class="transition-colors duration-200 hover:text-amber-300"
                                            >
                                                <Icon size={20} />
                                            </a>
                                        </li>
                                    ))
                                }
                            </ul>
                        </div>
                    </div>
                </div>

                <div
                    class="mt-4 grid grid-cols-1 items-stretch gap-4 sm:grid-cols-2 md:grid-cols-3 lg:mt-0"
                >
                    <div
                        id="about-me"
                        class="scroll-mt-8 border border-gray-700 p-4 backdrop-blur-2xl"
                    >
                        <h2
                            class="pb-2 text-lg font-semibold"
                        >
                            About Me
                        </h2>
                        <div class="space-y-4 text-sm">
                            <p>
                                I'm Renzo Damian, an AI Engineer at{" "}
                                <a
                                    target="_blank"
                                    class="underline"
                                    rel="noopener noreferrer"
                                    href="https://www.manduhr.com/"
                                    >Mandü HR</a
                                >{" "}
                                in Lima, Peru, working on applied AI and
                                autonomous systems.
                            </p>
                            <p>
                                I recently finished my Master's in Advanced
                                Computer Science at the University of Sheffield
                                (with Merit), where I also led the software team
                                at{" "}
                                <a
                                    target="_blank"
                                    class="underline"
                                    rel="noopener noreferrer"
                                    href="https://marsworks.sites.sheffield.ac.uk/"
                                    >Marsworks</a
                                >, developing autonomous navigation and mapping
                                for the{" "}
                                <a
                                    target="_blank"
                                    class="underline"
                                    rel="noopener noreferrer"
                                    href="https://www.anatolianrover.space/"
                                    >Anatolian Rover Challenge (ARC)</a
                                >.
                            </p>
                            <p>
                                I'm back coaching at{" "}
                                <a
                                    target="_blank"
                                    class="underline"
                                    rel="noopener noreferrer"
                                    href="https://www.robotek.pe/"
                                    >Robotek</a
                                >, preparing a team for the WRO 2026 finals in
                                Puerto Rico. Outside of work, I cycle to clear
                                my head and read science fiction — Asimov's
                                stories first sparked my fascination with AI and
                                robotics.
                            </p>
                        </div>
                    </div>
                    <div
                        id="experience"
                        class="border border-gray-700 p-4 backdrop-blur-2xl"
                    >
                        <h2
                            class="pb-2 text-lg font-semibold"
                        >
                            Experience
                        </h2>
                        <div class="space-y-4">
                            {
                                experiences.map((experience) => (
                                    <ExperienceItem
                                        title={experience.title}
                                        employer={experience.employer}
                                        date={experience.date}
                                    />
                                ))
                            }
                        </div>
                        <div class="mt-4 border-t border-gray-600 pt-4">
                            <h2
                                class="pb-2 text-lg font-semibold"
                            >
                                Education
                            </h2>
                            <div class="space-y-4">
                                {
                                    education.map((item) => (
                                        <EducationItem
                                            title={item.title}
                                            institution={item.institution}
                                            date={item.date}
                                        />
                                    ))
                                }
                            </div>
                        </div>
                        <div class="mt-4 border-t border-gray-600 pt-4">
                            <h2
                                class="pb-2 text-lg font-semibold"
                            >
                                Involvements
                            </h2>
                            <div class="space-y-4">
                                {
                                    involvements.map((involvement) => (
                                        <ExperienceItem
                                            title={involvement.title}
                                            employer={involvement.employer}
                                            date={involvement.date}
                                        />
                                    ))
                                }
                            </div>
                        </div>
                    </div>
                    <div
                        id="projects"
                        class="border border-gray-700 p-4 backdrop-blur-2xl sm:col-span-2 md:col-span-1"
                    >
                        <h2
                            class="text-lg font-semibold"
                        >
                            Projects
                        </h2>
                        <div class="space-y-4">
                            {
                                projects.map((project) => (
                                    <ProjectItem
                                        title={project.title}
                                        description={project.description}
                                        github_link={project.github_link}
                                    />
                                ))
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

    </main>
</Layout>
