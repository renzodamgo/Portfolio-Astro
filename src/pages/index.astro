---
import ExperienceItem from "../components/ExperienceItem.astro";
import ProjectItem from "../components/ProjectItem.astro";
import EducationItem from "../components/EducationItem.astro";
import Layout from "../layouts/Layout.astro";
import Renzo from "../assets/renzodamian-anatolianroverchallenge.webp";
import { Github, Linkedin, FileText, Mail } from "lucide-astro";

export interface Experience {
    title: string;
    employer: string;
    date: string;
}

export interface Project {
    title: string;
    description: string;
    github_link: string;
}

const experiences: Experience[] = [
    {
        title: "AI Engineer",
        employer: "Mandü HR",
        date: "Aug 2026 – Present",
    },
    {
        title: "Software Team Lead",
        employer: "Marsworks",
        date: "Oct 2024 – Oct 2025",
    },
    {
        title: "Fullstack Java Developer",
        employer: "Bevertec",
        date: "Sep 2022 — Sep 2023",
    },
    {
        title: "Frontend Developer",
        employer: "Rebels 247",
        date: "Nov 2021 — Feb 2022",
    },
];

const involvements: Experience[] = [
    {
        title: "Co-Founder",
        employer: "BLK Robotics",
        date: "Dic 2023 — Present",
    },
    {
        title: "Programming Coach",
        employer: "Robotek",
        date: "Feb 2024 – Sep 2024",
    },
];

const projects: Project[] = [
    {
        title: "Scarab: Self-Driving Mars Rover",
        description:
            "Designed and implemented the autonomous navigation pipeline for the Marsworks Scarab rover using ROS2, RTAB-Map SLAM, and Nav2.",
        github_link: "https://github.com/SheffMarsworks/ScarabRover",
    },
    {
        title: "WRO 2024: Autonomous Driving Robot",
        description:
            "Ackermann robot designed to autonomously complete a circuit and evade obstacles using computer vision, 2D Lidar, and PID control with analog sensors.",
        github_link: "https://github.com/marieblasi/wro2024-robotek",
    },
    {
        title: "Drivesafe: Driver Drowsiness Detection",
        description:
            "An ML-powered app detecting driver drowsiness and distraction using computer vision. Integrates PyTorch with Apple’s Core ML, leveraging YOLOv8 for on-device inference.",
        github_link: "https://github.com/renzodamgo/Drivesafe",
    },
];

const education = [
    {
        title: "Master of Science in Advanced Computer Science",
        description:
            "Completed with Merit at the University of Sheffield. Dissertation: Multi-Target Speaker Extraction for Conversational Enhancement using Deep Learning for the CHiME-9 ECHI Challenge.",
        institution: "University of Sheffield",
        date: "Sep 2024 – Oct 2025",
    },
    {
        title: "Bachelor of Science in Computer Science",
        description:
            "Graduated with a GPA of 3.5/4.0 from Universidad Peruana de Ciencias Aplicadas (UPC) with concentrations in Machine Learning and Computer Vision.",
        institution: "Universidad Peruana de Ciencias Aplicadas (UPC)",
        date: "Jan 2018 – Jul 2023",
    },
];

const socials = [
    {
        label: "GitHub",
        href: "https://github.com/renzodamgo",
        Icon: Github,
    },
    {
        label: "LinkedIn",
        href: "https://linkedin.com/in/renzo-damian",
        Icon: Linkedin,
    },
    {
        label: "Resume (PDF)",
        href: "/Renzo_Damian_CV.pdf",
        Icon: FileText,
    },
    {
        label: "Email",
        href: "mailto:redamiangomez1@sheffield.ac.uk",
        Icon: Mail,
    },
];
---

<Layout>
    <a
        href="#about"
        class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:rounded-sm focus:bg-amber-400 focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-coal-950"
    >
        Skip to content
    </a>

    <main class="bg-coal-950 text-cream-100">
        <div class="mx-auto w-full max-w-[760px] px-6 md:px-8">
            <header class="pt-14 md:pt-20">
                <h1
                    class="font-display max-w-[12ch] text-5xl leading-[0.95] font-bold text-balance uppercase md:text-6xl"
                >
                    Renzo Damian
                </h1>
                <p class="mt-4 max-w-[52ch] text-lg leading-snug text-cream-300">
                    AI Engineer working in robotics and artificial intelligence.
                </p>
                <p
                    class="mt-3 font-mono text-[12px] tracking-[0.08em] text-cream-500 uppercase"
                >
                    Sheffield, UK
                </p>

                <ul class="mt-6 flex flex-wrap items-center gap-3">
                    {
                        socials.map(({ label, href, Icon }) => (
                            <li>
                                <a
                                    href={href}
                                    target={
                                        href.startsWith("mailto:")
                                            ? undefined
                                            : "_blank"
                                    }
                                    rel={
                                        href.startsWith("mailto:")
                                            ? undefined
                                            : "noopener noreferrer"
                                    }
                                    aria-label={label}
                                    class="grid size-10 place-items-center border border-line text-cream-300 transition-colors duration-200 hover:border-amber-400 hover:text-amber-300"
                                >
                                    <Icon size={17} />
                                </a>
                            </li>
                        ))
                    }
                    <li>
                        <a
                            href="/Renzo_Damian_CV.pdf"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex h-10 items-center gap-2 bg-amber-400 px-4 text-sm font-semibold text-coal-950 transition-colors duration-200 hover:bg-amber-300"
                        >
                            <FileText size={15} aria-hidden="true" />
                            Resume
                        </a>
                    </li>
                </ul>
            </header>

            <div class="mt-12 pb-10 md:mt-14">
                <figure class="border border-line">
                    <img
                        class="aspect-[16/9] w-full object-cover grayscale"
                        src={Renzo.src}
                        width={800}
                        height={533}
                        alt="Renzo Damian with the Marsworks rover at the Anatolian Rover Challenge"
                        loading="eager"
                        fetchpriority="high"
                    />
                </figure>

                <section
                    id="about"
                    aria-labelledby="about-heading"
                    class="mt-12 scroll-mt-8"
                >
                    <h2
                        id="about-heading"
                        class="font-display border-t border-line pt-5 text-lg font-bold tracking-[0.04em] uppercase"
                    >
                        About
                    </h2>
                    <div
                        class="mt-4 max-w-[68ch] space-y-4 text-[15px] leading-[1.7] text-cream-300"
                    >
                        <p>
                            I'm Renzo Damian, a software engineer based in
                            Sheffield, focusing on robotics and artificial
                            intelligence.
                        </p>
                        <p>
                            Currently, I'm completing my Master's in Advanced
                            Computer Science while leading the software team at{" "}
                            <a
                                target="_blank"
                                class="text-cream-100 underline decoration-amber-400/70 underline-offset-4 transition-colors hover:text-amber-300"
                                rel="noopener noreferrer"
                                href="https://marsworks.sites.sheffield.ac.uk/"
                                >Marsworks</a
                            >, where I guide the development of autonomous
                            navigation and mapping in preparation for the{" "}
                            <a
                                target="_blank"
                                class="text-cream-100 underline decoration-amber-400/70 underline-offset-4 transition-colors hover:text-amber-300"
                                rel="noopener noreferrer"
                                href="https://www.anatolianrover.space/"
                                >Anatolian Rover Challenge (ARC)</a
                            >.
                        </p>
                        <p>
                            Outside of work and university, I like to stay
                            active by cycling. It's a great way to clear my
                            head. I also enjoy reading, especially science
                            fiction books like Asimov's stories, which first
                            sparked my fascination with AI and robotics.
                        </p>
                    </div>
                </section>

                <section aria-labelledby="experience-heading" class="mt-12">
                    <h2
                        id="experience-heading"
                        class="font-display border-t border-line pt-5 text-lg font-bold tracking-[0.04em] uppercase"
                    >
                        Experience
                    </h2>
                    <div class="mt-1 divide-y divide-line">
                        {
                            experiences.map((experience) => (
                                <ExperienceItem
                                    title={experience.title}
                                    employer={experience.employer}
                                    date={experience.date}
                                />
                            ))
                        }
                    </div>
                </section>

                <section aria-labelledby="projects-heading" class="mt-12">
                    <h2
                        id="projects-heading"
                        class="font-display border-t border-line pt-5 text-lg font-bold tracking-[0.04em] uppercase"
                    >
                        Projects
                    </h2>
                    <div class="mt-1 divide-y divide-line">
                        {
                            projects.map((project) => (
                                <ProjectItem
                                    title={project.title}
                                    description={project.description}
                                    github_link={project.github_link}
                                />
                            ))
                        }
                    </div>
                </section>

                <section aria-labelledby="education-heading" class="mt-12">
                    <h2
                        id="education-heading"
                        class="font-display border-t border-line pt-5 text-lg font-bold tracking-[0.04em] uppercase"
                    >
                        Education
                    </h2>
                    <div class="mt-1 divide-y divide-line">
                        {
                            education.map((item) => (
                                <div class="py-4">
                                    <EducationItem
                                        title={item.title}
                                        institution={item.institution}
                                        date={item.date}
                                    />
                                    <p class="mt-2 max-w-[68ch] text-sm leading-relaxed text-cream-300">
                                        {item.description}
                                    </p>
                                </div>
                            ))
                        }
                    </div>
                </section>

                <section aria-labelledby="involvements-heading" class="mt-12">
                    <h2
                        id="involvements-heading"
                        class="font-display border-t border-line pt-5 text-lg font-bold tracking-[0.04em] uppercase"
                    >
                        Involvement
                    </h2>
                    <div class="mt-1 divide-y divide-line">
                        {
                            involvements.map((involvement) => (
                                <ExperienceItem
                                    title={involvement.title}
                                    employer={involvement.employer}
                                    date={involvement.date}
                                />
                            ))
                        }
                    </div>
                </section>
            </div>

            <footer
                class="flex flex-wrap items-center justify-between gap-3 border-t border-line py-7 font-mono text-[11px] tracking-[0.1em] text-cream-500 uppercase"
            >
                <p>Renzo Damian — Sheffield, UK</p>
                <p>Built with Astro</p>
            </footer>
        </div>
    </main>
</Layout>
