---
import { getCollection } from "astro:content";
import LearnLayout from "../../layouts/LearnLayout.astro";
import { SITE } from "../../lib/learn";

const guides = (await getCollection("guides")).sort(
    (a, b) => a.data.order - b.data.order,
);

const canonical = `${SITE}/learn/`;
const title = "Learn | Guías de robótica y programación | Renzo Damian";
const description =
    "Guías prácticas en español para aprender robótica programando: empieza con la estrategia del reto Open de la WRO, con ejercicios, pruebas y un simulador.";

const jsonld = {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "@id": `${canonical}#webpage`,
    url: canonical,
    name: "Learn",
    description,
    inLanguage: "es",
    isPartOf: { "@type": "WebSite", name: "Renzo Damian", url: `${SITE}/` },
    author: { "@type": "Person", name: "Renzo Damian", url: `${SITE}/` },
    mainEntity: {
        "@type": "ItemList",
        itemListElement: guides.map((guide, index) => ({
            "@type": "ListItem",
            position: index + 1,
            url: `${SITE}/learn/${guide.id}/`,
            name: guide.data.title,
        })),
    },
};
---

<LearnLayout
    title={title}
    description={description}
    canonical={canonical}
    jsonld={jsonld}
    width="wide"
    panel={false}
>
    <header class="mb-4 max-w-2xl border border-white/15 bg-black/60 shadow-[0_8px_32px_rgba(0,0,0,0.55),inset_0_1px_0_rgba(255,255,255,0.06)] backdrop-blur-xl p-4 md:p-6">
        <p class="text-sm font-medium tracking-wide text-amber-400 uppercase">
            Learn
        </p>
        <h1 class="mt-2 text-4xl font-semibold">Aprende construyendo</h1>
        <p class="mt-4 text-white/80">
            Guías paso a paso para aprender robótica escribiendo código que se
            puede probar. Cada paso tiene su explicación, ejercicios y una
            solución verificada.
        </p>
    </header>

    <ul class="grid gap-4 sm:grid-cols-2">
        {
            guides.map((guide) => (
                <li class="flex">
                    <a
                        href={`/learn/${guide.id}/`}
                        class="group flex w-full flex-col justify-between gap-6 learn-card shadow-[0_8px_32px_rgba(0,0,0,0.55),inset_0_1px_0_rgba(255,255,255,0.06)] backdrop-blur-xl p-4"
                    >
                        <div>
                            <h2 class="text-xl font-semibold transition-colors group-hover:text-amber-300">
                                {guide.data.title}
                            </h2>
                            <p class="mt-2 text-sm text-white/80">
                                {guide.data.summary}
                            </p>
                        </div>
                        <p class="flex flex-wrap gap-x-4 gap-y-1 text-xs text-white/70">
                            <span>Nivel: {guide.data.level}</span>
                            <span>
                                Unas {Math.round(guide.data.minutes / 60)} h
                            </span>
                            <span class="font-semibold text-amber-400 underline-offset-4 group-hover:underline">Empezar →</span>
                        </p>
                    </a>
                </li>
            ))
        }
    </ul>
</LearnLayout>
