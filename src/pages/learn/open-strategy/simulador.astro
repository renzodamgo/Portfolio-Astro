---
import LearnLayout from "../../../layouts/LearnLayout.astro";
import CarSim from "../../../components/learn/CarSim.astro";
import { GUIDE_BASE, SITE } from "../../../lib/learn";

const canonical = `${SITE}${GUIDE_BASE}simulador/`;
const title = "Simulador del coche | Estrategia del Open | Renzo Damian";
const description =
    "Conduce en el navegador el coche del reto Open de la WRO con el teclado y mira lo que ve su LiDAR y su cámara.";

const jsonld = {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    "@id": `${canonical}#app`,
    url: canonical,
    name: "Simulador del coche del reto Open",
    description,
    inLanguage: "es",
    applicationCategory: "EducationalApplication",
    operatingSystem: "Any",
    author: { "@type": "Person", name: "Renzo Damian", url: `${SITE}/` },
    isPartOf: {
        "@type": "Course",
        name: "Construye la estrategia del Open",
        url: `${SITE}${GUIDE_BASE}`,
    },
};
---

<LearnLayout
    title={title}
    description={description}
    canonical={canonical}
    jsonld={jsonld}
>
    <nav aria-label="Ruta" class="mb-6 text-sm text-white/70">
        <a class="hover:text-amber-300" href="/learn/">Learn</a>
        <span aria-hidden="true"> / </span>
        <a class="hover:text-amber-300" href={GUIDE_BASE}>Estrategia del Open</a>
        <span aria-hidden="true"> / </span>
        <span>Simulador</span>
    </nav>

    <h1 class="text-3xl font-semibold md:text-4xl">Simulador del coche</h1>
    <p class="mt-3 max-w-3xl text-white/80">
        Conduce el coche por el campo del reto Open directamente en el
        navegador. Sirve para sentir cómo responde la dirección y para ver lo
        que mide el LiDAR antes de programar la estrategia. Cada paso de la guía
        trae su propio reto: el panel Reto cambia con el paso que abres.
    </p>

    <div class="mt-8" data-sim-root>
        <CarSim challenge />
    </div>

    <section aria-labelledby="teclas" class="mt-8">
        <h2 id="teclas" class="text-lg font-semibold">Teclas</h2>
        <ul class="mt-3 grid gap-x-8 gap-y-2 text-sm text-white/80 sm:grid-cols-2 xl:grid-cols-4">
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">W / flecha arriba</kbd>: acelerar.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">S / flecha abajo</kbd>: reversa.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">A D / flechas laterales</kbd>: girar la dirección.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">Espacio</kbd>: freno.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">R</kbd>: reiniciar.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">V</kbd>: cambiar de cámara.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">L</kbd>: mostrar u ocultar el abanico del LiDAR.</li>
            <li><kbd class="border border-white/15 bg-white/10 px-1.5 py-0.5 font-mono text-xs">T</kbd>: cambiar el límite de dirección entre ±17,6° y ±25°.</li>
        </ul>
    </section>
</LearnLayout>
